# ==============================================================================
# IIOL (IsInOurLib?) Environment Variables Configuration Template
# ------------------------------------------------------------------------------
# 이 파일을 복사하여 '.env' 파일로 이름을 변경한 뒤 사용하세요.
# 라즈베리파이 배포 환경과 로컬 개발 환경의 값들을 적절히 분리하여 설정할 수 있습니다.
# ==============================================================================

# 1. Django Application Settings
TARGET_ENV=dev                      # 'dev' (로컬 개발) 또는 'prod' (라즈베리파이 운영 배포)
DEBUG=True                          # 로컬에서는 True, 운영 배포시에는 False 지정
SECRET_KEY=change-this-to-a-very-secure-random-string-12345!
ALLOWED_HOSTS=localhost,127.0.0.1,thecloudpark.xyz,iiol.thecloudpark.xyz

# URL Service Prefix (필요시 도메인 서브경로 지정, 예: '/app')
MY_URL_PREFIX=
SERVER_ALIAS=iiol-local

# 2. PostgreSQL Configuration (Docker Compose & Django Connection)
POSTGRES_DB=iiol
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1             # 로컬 실행시 127.0.0.1, 라즈베리파이 도커망 내부에서는 'db'
POSTGRES_PORT=5432

# 3. Redis Configuration (Docker Compose & Celery/Cache Connection)
REDIS_PORT=6379
REDIS_LOCATION=redis://127.0.0.1:6379/0  # 로컬 개발시 127.0.0.1, 라즈베리파이 도커망 내부에서는 'redis'
